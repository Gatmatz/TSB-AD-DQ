# Credentials and ports of the experiment services; copy to `.env` (git-ignored) and change the secrets.
# Read by docker-compose.yml and by the Python code (`database.load_env`); shell variables win.

# Postgres (results database)
POSTGRES_USER=tsbad
POSTGRES_PASSWORD=tsbad
POSTGRES_DB=tsbad_quality
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# MinIO (object storage)
MINIO_ROOT_USER=tsbad
MINIO_ROOT_PASSWORD=tsbad-secret
MINIO_ENDPOINT=localhost:9100
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# Adminer (web UI for Postgres)
ADMINER_PORT=8082

# Name of this setup (machine, environment, ...); stored in experiments.execution_profile
EXECUTION_PROFILE=local
